# Application Configuration
APP_NAME=DeepResearch OS
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret-key

# API Gateway & Deployment
API_PREFIX=/api/v1
# On Vercel, BACKEND_URL can be set to your backend Vercel URL or omitted if deployed as a unified project
BACKEND_URL=https://your-backend-app.vercel.app
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","https://your-app.vercel.app"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==========================================================
# 🧠 LLM AI Providers & Default Models
# ==========================================================

# 1. Google Gemini (Default Model: gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq LPU (Default Model: llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# 3. NVIDIA NIM (Default Model: z-ai/glm-5.2)
NVIDIA_API_KEY=your_nvidia_api_key_here

# 4. OpenRouter (Default Model: meta-llama/llama-3.3-70b-instruct)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default LLM Provider Selection
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# ==========================================================
# 🔍 Search Engine
# ==========================================================
TAVILY_API_KEY=your_tavily_api_key_here

# ==========================================================
# 💾 Storage & Neon Serverless PostgreSQL Database
# ==========================================================

# Neon Serverless PostgreSQL Connection String (from https://neon.tech):
# Example: postgresql://username:password@ep-xyz-123.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis Cache & Event Queue (Optional)
REDIS_URL=redis://default:your_password@your_endpoint.upstash.io:6379

# Qdrant Vector Store Cloud Index (Optional)
QDRANT_URL=https://xyz-example.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
