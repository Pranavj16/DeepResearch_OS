# Application Configuration
APP_NAME=DeepResearch OS
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret-key

# API Gateway
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==========================================================
# 🧠 LLM AI Providers & Default Models
# ==========================================================

# 1. Google Gemini (Default Model: gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq LPU (Default Model: llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# 3. NVIDIA NIM (Default Model: z-ai/glm-5.2)
NVIDIA_API_KEY=your_nvidia_api_key_here

# 4. OpenRouter (Default Model: meta-llama/llama-3.3-70b-instruct)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default LLM Provider Selection
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# ==========================================================
# 🔍 Search Engine
# ==========================================================
TAVILY_API_KEY=your_tavily_api_key_here

# ==========================================================
# 💾 Storage, Caching & Vector Database
# ==========================================================

# Relational Database (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_assistant

# Upstash Redis Cache & Event Queue
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Store Index
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
