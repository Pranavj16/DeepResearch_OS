# Application
APP_NAME=Research Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-development-secret

# API
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=10 days
LOG_SERIALIZE=false

# LLM provider credentials
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_PROVIDER=nvidia
DEFAULT_MODEL=z-ai/glm-5.2
REQUEST_TIMEOUT=60
MAX_RETRIES=3

# Search and reader
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=30
TAVILY_MAX_RESULTS=5
READER_TIMEOUT_SECONDS=30
READER_CHUNK_SIZE=4000

# Platform services
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=

# Browser clients
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
