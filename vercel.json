{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/backend"
    },
    {
      "source": "/docs(.*)",
      "destination": "/api/backend"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/backend"
    },
    {
      "source": "/redoc(.*)",
      "destination": "/api/backend"
    },
    {
      "source": "/(.*)",
      "destination": "/api/frontend"
    }
  ]
}
